ENV PATH=/pnpm:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PNPM_HOME=/pnpm \
    DEBIAN_FRONTEND=noninteractive \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    INSTALL=True \
    BROWSER_TYPE=webkit \
    PLANT_PATH=/app/env \
    WEREAD_LIC_PATH=/app/data/wx.lic \
    WEREAD_PROFILE_DIR=/app/data/weread-chrome-profile \
    PLAYWRIGHT_BROWSERS_PATH=/app/env/driver/_x86_64
WORKDIR /app
EXPOSE 8001
ENTRYPOINT ["/app/env_x86_64/bin/python3", "/app/wechat-state.py"]
