FROM ghcr.io/rachelos/we-mp-rss@sha256:125472e8a58a05f02b930ba2b958575ffc87378743d9491383b13390f709215e AS repacked
COPY containers/repack-image.py /repack-image.py
COPY containers/wechat-state.py /app/wechat-state.py
RUN sed -i 's/print(f"{k}={v}")/print(f"{k}=<redacted>")/' /app/main.py && python3 /repack-image.py

FROM scratch
