{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geo-seo-system-cron",
  "main": "workers/cron.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "NODE_ENV": "production",
    "ENABLE_CLOUDFLARE_CRON": "true",
    "CLOUDFLARE_CRON_MODE": "primary",
    "CLOUDFLARE_MONITOR_NEWS_ENABLED": "true",
    "CLOUDFLARE_MONITOR_SOCIAL_ENABLED": "true",
    "CLOUDFLARE_MONITOR_CRON": "35 11 * * *",
    "CLOUDFLARE_CANARY_MAX_KEYWORDS": "1",
    "CLOUDFLARE_CANARY_MAX_ARTICLES": "2",
    "CLOUDFLARE_CANARY_SOURCES": "serper",
    "CLOUDFLARE_PRIMARY_MAX_KEYWORDS": "100",
    "CLOUDFLARE_PRIMARY_CRON": "15,40 1-23/2 * * *",
    "CLOUDFLARE_PRIMARY_NEWS_MAX_ARTICLES": "18",
    "CLOUDFLARE_PRIMARY_NEWS_SOURCES": "serper,rss",
    "CLOUDFLARE_PRIMARY_SOCIAL_MAX_ARTICLES": "30",
    "CLOUDFLARE_PRIMARY_SOCIAL_SOURCES": "gate_square,telegram,x,binance_square",
    "CLOUDFLARE_CHINESE_SOCIAL_ENABLED": "true",
    "CLOUDFLARE_CHINESE_SOCIAL_INTERVAL_HOURS": "2",
    "CLOUDFLARE_CHINESE_SOCIAL_MAX_KEYWORDS": "5",
    "CLOUDFLARE_CHINESE_SOCIAL_KEYWORDS": "孙宇晨,波场,TRON,Justin Sun,孙割",
    "CLOUDFLARE_CHINESE_SOCIAL_PLATFORMS": "xiaohongshu,douyin,kuaishou,bilibili,weibo,tieba,zhihu",
    "CLOUDFLARE_CHINESE_SOCIAL_BROWSER_ENABLED": "true",
    "CLOUDFLARE_CHINESE_SOCIAL_BROWSER_MAX_CALLS_PER_RUN": "35",
    "CLOUDFLARE_BINANCE_SHADOW_ENABLED": "true",
    "CLOUDFLARE_BINANCE_WRITE_ENABLED": "true",
    "CLOUDFLARE_BINANCE_MAX_QUERIES": "4",
    "CLOUDFLARE_BINANCE_QUERY_TERMS": "孙宇晨,波场,TRON,Justin Sun",
    "CLOUDFLARE_BINANCE_INTERVAL_HOURS": "2",
    "CLOUDFLARE_CLEANUP_ENABLED": "true",
    "CLOUDFLARE_WEEKLY_REPORT_ENABLED": "true",
    "CLOUDFLARE_MONTHLY_REPORT_ENABLED": "true",
    "CLOUDFLARE_GEO_DAILY_ENABLED": "true",
    "CLOUDFLARE_GEO_DAILY_MAX_CELLS": "4",
    "CLOUDFLARE_GEO_DAILY_TOTAL_CELLS": "24",
    "CLOUDFLARE_GEO_DAILY_CONCURRENCY": "2",
    "CLOUDFLARE_GEO_DAILY_START_HOUR": "11",
    "CLOUDFLARE_GEO_DAILY_REQUIRE_OPENROUTER_PREFLIGHT": "true",
    "CLOUDFLARE_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "CLOUDFLARE_AI_MAX_TOKENS": "512",
    "CLOUDFLARE_OPENROUTER_FALLBACK_ENABLED": "true",
    "CLOUDFLARE_OPENROUTER_FALLBACK_MODEL": "deepseek/deepseek-chat",
    "CLOUDFLARE_GEO_WEEKLY_ENABLED": "true",
    "CLOUDFLARE_GEO_WEEKLY_ALL_PLATFORMS": "true",
    "CLOUDFLARE_GEO_WEEKLY_MAX_CELLS": "10",
    "CLOUDFLARE_GEO_WEEKLY_CONCURRENCY": "4",
    "CLOUDFLARE_GEO_WEEKLY_MAX_TOKENS": "1536",
    "CLOUDFLARE_GEO_WEEKLY_START_HOUR": "3",
    "CLOUDFLARE_OPENROUTER_PREFLIGHT_ENABLED": "true",
    "CLOUDFLARE_OPENROUTER_PREFLIGHT_MODEL": "openai/gpt-4o-mini",
    "CLOUDFLARE_OPENROUTER_PREFLIGHT_MAX_AGE_HOURS": "26",
    "CLOUDFLARE_REALTIME_ALERTS_ENABLED": "true",
    "CLOUDFLARE_BRIEFING_ENABLED": "true",
    "CLOUDFLARE_BRIEFING_MODE": "negative_only",
    "CLOUDFLARE_FAILURE_NOTIFICATIONS_ENABLED": "true",
    "CLOUDFLARE_FETCH_OBSERVABILITY_ENABLED": "true",
    "CLOUDFLARE_BROWSER_FULLTEXT_SHADOW_ENABLED": "true",
    "CLOUDFLARE_BROWSER_FULLTEXT_MAX_PAGES_PER_DAY": "4",
    "CLOUDFLARE_BROWSER_FULLTEXT_MAX_MS_PER_DAY": "480000",
    "CLOUDFLARE_BROWSER_FULLTEXT_TIMEOUT_MS": "22000",
    "CLOUDFLARE_BROWSER_FULLTEXT_COOLDOWN_SECONDS": "75",
    "CLOUDFLARE_GATE_FIRECRAWL_ENABLED": "false",
    "CLOUDFLARE_GATE_BROWSER_INTERVAL_HOURS": "6",
    "CLOUDFLARE_GATE_SERPER_QUERY_TERMS": "TRON,TRX,孙宇晨,Justin Sun",
    "CLOUDFLARE_ACCEPTANCE_WINDOW_START": "1785377555000",
    "CLOUDFLARE_STAGE3_REQUIRED_DAYS": "0",
    "CLOUDFLARE_STAGE6_WINDOW_START": "1785805139142",
    "CLOUDFLARE_STAGE6_REQUIRED_DAYS": "0",
    "CLOUDFLARE_GEO_CATCHUP_DELAY_SECONDS": "5",
    "CLOUDFLARE_MAINTENANCE_OFFSET_MINUTES": "15",
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "RESEND_FROM": "GEO+SEO 系统 <onboarding@resend.dev>",
    "AUTH_ALLOWED_EMAIL": "hans.pan007@gmail.com"
  },
  "ai": {
    "binding": "AI"
  },
  "services": [
    {
      "binding": "BINANCE_BROWSER",
      "service": "geo-seo-system-binance-browser"
    },
    {
      "binding": "FULLTEXT_BROWSER",
      "service": "geo-seo-system-fulltext-browser"
    },
    {
      "binding": "CHINESE_SOCIAL_BROWSER",
      "service": "geo-seo-system-chinese-social-browser"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MONITOR_QUEUE",
        "queue": "geo-seo-monitor"
      },
      {
        "binding": "BROWSER_SHADOW_QUEUE",
        "queue": "geo-seo-browser-shadow"
      }
    ],
    "consumers": [
      {
        "queue": "geo-seo-monitor",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 4,
        "max_concurrency": 3,
        "retry_delay": 30
      },
      {
        "queue": "geo-seo-browser-shadow",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "max_concurrency": 1,
        "retry_delay": 60
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MONITOR_COORDINATOR",
        "class_name": "MonitorCoordinator"
      },
      {
        "name": "BROWSER_SHADOW_BUDGET",
        "class_name": "BrowserShadowBudget"
      },
      {
        "name": "MIGRATION_ACCEPTANCE",
        "class_name": "MigrationAcceptanceLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-monitor-coordinator",
      "new_sqlite_classes": ["MonitorCoordinator"]
    },
    {
      "tag": "v2-browser-shadow-budget",
      "new_sqlite_classes": ["BrowserShadowBudget"]
    },
    {
      "tag": "v3-migration-acceptance-ledger",
      "new_sqlite_classes": ["MigrationAcceptanceLedger"]
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "cd45e0e89ac544eebd5eb7eb0ab3b8de"
    }
  ],
  "triggers": {
    "crons": ["15,40 1-23/2 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
