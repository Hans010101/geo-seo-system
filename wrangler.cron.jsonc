{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geo-seo-system-cron",
  "main": "workers/cron.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "NODE_ENV": "production",
    "ENABLE_CLOUDFLARE_CRON": "true",
    "CLOUDFLARE_CRON_MODE": "canary",
    "CLOUDFLARE_MONITOR_CRON": "35 11 * * *",
    "CLOUDFLARE_CANARY_MAX_KEYWORDS": "1",
    "CLOUDFLARE_CANARY_MAX_ARTICLES": "2",
    "CLOUDFLARE_CANARY_SOURCES": "serper",
    "CLOUDFLARE_MAINTENANCE_OFFSET_MINUTES": "15",
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "cd45e0e89ac544eebd5eb7eb0ab3b8de"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
