{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geo-seo-system-chinese-social-browser",
  "account_id": "a828bebda1f352216c7d7da425bad17a",
  "main": "workers/chinese-social-browser.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "SOCIAL_STATE",
      "bucket_name": "geo-seo-system-state"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
